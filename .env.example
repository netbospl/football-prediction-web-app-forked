# Football Prediction Web App Configuration
# Copy this file to .env and customize as needed

# Storage backend: "local" or "azure"
# - local: Uses local filesystem (no Azure credentials needed)
# - azure: Uses Azure Blob Storage (requires AZURE_* variables below)
STORAGE_BACKEND=local

# Local data directory (relative to project root)
DATA_DIR=data

# SQLite database path (for runs, predictions, trades, results)
DB_PATH=data/app.db

# Azure Blob Storage settings (only needed if STORAGE_BACKEND=azure)
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_CONTAINER_NAME=football-data
