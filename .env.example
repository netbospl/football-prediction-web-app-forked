# Required Azure settings
AZURE_CONNECTION_STRING=your-azure-connection-string-here
AZURE_CONTAINER_NAME=football-data

# Optional overrides (safe defaults applied if omitted)
# FOOTBALL_DATA_URL=https://www.football-data.co.uk
# FOOTBALL_DATA_TABLE=mmz4281
# PREDICTED_FPATH=static/predicted.txt

# Optional predictions source for the dashboard
# Set to "local" to read from a local Parquet file instead of Azure.
# When PREDICTIONS_SOURCE=local, AZURE_* can be omitted, but pipelines and
# Azure uploads will not work.
# PREDICTIONS_SOURCE=azure
# PREDICTIONS_LOCAL_PATH=data/predictions_valid.parquet
